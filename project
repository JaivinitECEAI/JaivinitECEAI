import pandas as pd
import numpy as np
import os
import datetime

FILE = "jee_data.csv"
streak_file = "streak.txt"

# ================================
# INIT
# ================================

if not os.path.exists(FILE):
    pd.DataFrame(
        columns=["user", "pc", "cc", "mc"]
    ).to_csv(FILE, index=False)

# ================================
# LOAD SAVE
# ================================

def load():
    return pd.read_csv(FILE)

def save(df):
    df.to_csv(FILE, index=False)

# ================================
# SAFE INPUT
# ================================

def safe_int(msg, limit=100):

    try:
        val = int(input(msg))

        if val < 0:
            return 0

        if val > limit:
            print(f"⚠ Max Allowed = {limit}")
            return limit

        return val

    except:
        print("⚠ Invalid Input → 0")
        return 0

# ================================
# LOGIN
# ================================

def login():

    try:
        user = input("Enter Username: ").strip()

        if user == "":
            user = "demo"

        return user

    except:
        return "demo"

# ================================
# TOTAL
# ================================

def total(r):
    return r["pc"] + r["cc"] + r["mc"]

# ================================
# ADD TEST
# ================================

def add_test(user):

    df = load()

    print("\n🔥 ENTER TEST DATA")

    print("\n📘 Physics")
    pc = safe_int("Marks (0-100): ", 100)
   
    if pc > 100:

        print("\n⚠ TOTAL MARKS CANNOT EXCEED 100")
        print("❌ Test Not Saved")
        return

    print("\n🧪 Chemistry")
    cc = safe_int("Marks (0-100): ", 100)
    
    if cc > 100:

        print("\n⚠ TOTAL MARKS CANNOT EXCEED 100")
        print("❌ Test Not Saved")
        return

    print("\n📐 Maths")
    mc = safe_int("Marks (0-100): ", 100)
    
    if mc > 100:

        print("\n⚠ TOTAL MARKS CANNOT EXCEED 100")
        print("❌ Test Not Saved")
        return

    total_marks = pc + cc + mc

    # REALISTIC LIMIT
    
    if total_marks > 300:

        print("\n⚠ TOTAL MARKS CANNOT EXCEED 300")
        print("❌ Test Not Saved")
        return

    # REALISTIC FEEDBACK
    if total_marks < 40:
        print("\n⚠ Very Low Score Detected")
        print("👉 Focus On Basics + NCERT")

    elif total_marks > 250:
        print("\n🔥 TOPPER LEVEL PERFORMANCE")

    # SAVE
    new = pd.DataFrame(
        [[user, pc, cc, mc]],
        columns=["user", "pc", "cc", "mc"]
    )

    df = pd.concat([df, new], ignore_index=True)

    save(df)

    print("\n✅ Test Saved Successfully")
    print("📊 Total Score:", total_marks, "/300")

# ================================
# ANALYTICS
# ================================

def analytics(user):

    df = load()
    df = df[df["user"] == user]

    if df.empty:
        print("⚠ No Data")
        return

    df["total"] = df.apply(total, axis=1)

    scores = df["total"]

    print("\n📊 ANALYTICS")
    print("----------------------")
    print("Average:", round(scores.mean(), 2), "/300")
    print("Best:", scores.max())
    print("Worst:", scores.min())
    print("Tests Given:", len(scores))
    print("Consistency:", round(100 - np.std(scores), 2), "%")

