# ================================
# IMPROVEMENT TRACKER
# ================================

def improvement(user):

    df = load()
    df = df[df["user"] == user]

    if len(df) < 2:
        print("⚠ Need at least 2 tests")
        return

    df["total"] = df.apply(total, axis=1)

    first = df["total"].iloc[0]
    last = df["total"].iloc[-1]

    improve = last - first

    print("\n📈 IMPROVEMENT TRACKER")
    print("First Score:", first)
    print("Latest Score:", last)

    if improve > 0:
        print("🔥 Improved By:", improve)

    elif improve < 0:
        print("⚠ Dropped By:", abs(improve))

    else:
        print("👉 No Change")

