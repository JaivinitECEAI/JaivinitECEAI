# ================================
# REAL RANK
# ================================

def real_rank(user):

    df = load()

    if df.empty:
        print("⚠ No Data")
        return

    df["total"] = df.apply(total, axis=1)

    avg_scores = df.groupby("user")["total"].mean()

    if user not in avg_scores:
        print("⚠ No Data")
        return

    sorted_scores = avg_scores.sort_values(ascending=False)

    rank = list(sorted_scores.index).index(user) + 1

    print("\n🏆 Real Rank:", rank, "/", len(sorted_scores))

