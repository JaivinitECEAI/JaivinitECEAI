# ================================
# STUDY STREAK
# ================================

def streak():

    today = str(datetime.date.today())

    if not os.path.exists(streak_file):

        with open(streak_file, "w") as f:
            f.write(today + "\n1")

        print("\n🔥 Current Streak: 1 Day")
        return

    with open(streak_file, "r") as f:
        data = f.readlines()

    last_date = data[0].strip()
    streak_days = int(data[1])

    old = datetime.datetime.strptime(last_date, "%Y-%m-%d").date()
    now = datetime.datetime.strptime(today, "%Y-%m-%d").date()

    diff = (now - old).days

    if diff == 1:
        streak_days += 1

    elif diff > 1:
        streak_days = 1

    with open(streak_file, "w") as f:
        f.write(today + "\n" + str(streak_days))

    print("\n🔥 CURRENT STUDY STREAK:", streak_days, "days")

